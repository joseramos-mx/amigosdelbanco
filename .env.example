# Copia este archivo a .env.local y llena los valores.
# En producción viven en Vercel → Project Settings → Environment Variables.

# ── Base de datos ─────────────────────────────────────────────────────
# Postgres es la fuente de verdad: el webhook escribe aquí y el sitio lee
# de aquí. Usa el POOLER en modo transacción de Supabase (puerto 6543),
# nunca el puerto directo 5432: cada instancia de función abre su pool.
DATABASE_URL=postgres://postgres.PROYECTO:CONTRASENA@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Conexiones por instancia. 3 es el valor por omisión y el techo sano en
# Vercel; bájalo a 1 si apuntas a un Postgres local de una sola conexión.
# RUN_DB_MAX_CONEXIONES=3

# ── Stripe ────────────────────────────────────────────────────────────
STRIPE_MODE=test
STRIPE_SECRET_KEY_TEST=sk_test_...
STRIPE_SECRET_KEY_LIVE=sk_live_...

# Webhook de donativos (/api/webhooks/stripe)
STRIPE_WEBHOOK_SECRET_TEST=whsec_...
STRIPE_WEBHOOK_SECRET_LIVE=whsec_...

# Webhook de la carrera (/api/run/webhook) — endpoint aparte en el
# Dashboard de Stripe, con su propio secreto de firma.
STRIPE_RUN_WEBHOOK_SECRET_TEST=whsec_...
STRIPE_RUN_WEBHOOK_SECRET_LIVE=whsec_...

# Métodos de pago de la carrera. OXXO y SPEI (customer_balance) hay que
# activarlos antes en Stripe → Settings → Payment methods, para MX;
# mandar uno no activado hace fallar la creación de la sesión.
RUN_METODOS_PAGO=card

# ── Inscripciones ─────────────────────────────────────────────────────
# Firma los tokens de activación del boleto. Mínimo 32 caracteres:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RUN_TOKEN_SECRET=

# Protege /api/run/cron/expirar y /api/admin/backfill. Vercel Cron lo manda
# como Bearer; el backfill se dispara a mano una sola vez:
#   curl -X POST https://bancodurango.org/api/admin/backfill \
#        -H "Authorization: Bearer $CRON_SECRET"
CRON_SECRET=

# ── Correo ────────────────────────────────────────────────────────────
RESEND_API_KEY=

# Remitente. El dominio debe estar verificado en Resend, pero la dirección
# NO necesita ser un buzón: enviar lo autoriza el DNS, no una bandeja.
# Sin esto se usa onboarding@resend.dev, que solo entrega a la cuenta dueña
# de Resend — todo lo demás se descarta en silencio.
RESEND_FROM_EMAIL="Social Run <no-reply@bancodurango.org>"

# A dónde llegan las respuestas. Aquí sí hace falta un buzón real; sirve
# cualquiera que ya tengas. Si se deja vacío, contestar rebota.
RESEND_REPLY_TO=

# ── Sitio ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://bancodurango.org
NEXT_PUBLIC_DONATION_GOAL_MXN=750000
